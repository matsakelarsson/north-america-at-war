{
  "name": "north-america-at-war",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive map of North America's wars, c. 800 to today",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "fetch-data": "node tools/fetch-data.mjs",
    "geo": "node tools/build-geo.mjs",
    "draft": "node tools/draft-keyframes.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --dev && node tools/serve.mjs --dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "d3-geo": "^3.1.2",
    "mapshaper": "^0.8.5",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.1.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "yaml": "^2.9.1"
  }
